# ======================== 主循环 helpers ========================
def update_fps():
    # 1s 滚动窗口 FPS. 不用 time.clock() 因为它只算单帧间隔, 切档抖动时数字跳.
    global fps, fps_count, fps_window_start
    fps_count += 1
    elapsed = time.ticks_diff(time.ticks_ms(), fps_window_start)
    if elapsed >= 1000:
        fps = fps_count * 1000.0 / elapsed
        fps_count = 0
        fps_window_start = time.ticks_ms()


def mount_sd_if_needed():
    global sd_mount_flag
    if sd_mount_flag == 0:
        print("try mount sd")
        mount_sdcard_manually()
    elif sd_mount_flag == 2:
        print("sd mounted")
        sd_mount_flag = 1


def compute_target_xy(locked_blob):
    # blob 像素坐标 → 飞控期望的"中心化 + 翻Y + LPF"输出. 状态化(跨帧用 last_x/last_y), 每帧只调一次.
    global last_x, last_y
    raw_x = locked_blob.cx() - FRAME_CENTER_X - FRAME_X_OFFSET
    raw_y = FRAME_CENTER_Y - locked_blob.cy() + FRAME_Y_OFFSET    # 翻 Y + 飞控俯仰偏置
    x = int(LPF_FACTOR * raw_x + (1 - LPF_FACTOR) * last_x)
    y = int(LPF_FACTOR * raw_y + (1 - LPF_FACTOR) * last_y)
    last_x = x
    last_y = y
    return x, y


def record_frame_to_sd(img):
    # 每 N 帧写 1 帧到 SD 视频文件
    global _record_frame_skip, record_state_flag
    if not ENABLE_VIDEO_RECORDING or Record_State != STATE_RECORD_START:
        return
    if mjpeg_flag != 1 or m_handle is None:
        return
    _record_frame_skip += 1
    if _record_frame_skip < RECORD_EVERY_N_FRAMES:
        return
    _record_frame_skip = 0
    try:
        m_handle.write(img, quality=RECORD_QUALITY)
        if record_state_flag < 1:
            send_record_state(1, 0)
            record_state_flag = 1
    except Exception as e:
        print("write failed: {}".format(e))


