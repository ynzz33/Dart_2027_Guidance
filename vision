# ======================== SD 卡 ========================
def mount_sdcard_manually():
    # sd_mount_flag 三态: 0=未挂载(每帧重试)/2=刚成功(下一帧转1)/1=稳定可写.
    global sd_mount_flag
    if sd_mount_flag != 0:
        return
    try:
        os.mount(SD, "/sd")
        sd_mount_flag = 2
    except OSError as e:
        sd_mount_flag = 0
        print("sd mount failed: {}".format(e))


def next_log_index():
    # 找到下一个可用的日志编号（从 1 开始递增）
    try:
        files = os.listdir("/sd")
        max_idx = 0
        for f in files:
            if f.startswith("log_") and f.endswith(".txt"):
                try:
                    idx = int(f[4:-4])      # 去掉 "log_" 和 ".txt"
                    if idx > max_idx:
                        max_idx = idx
                except ValueError:
                    pass                     # 旧格式（时间戳）跳过
        return max_idx + 1
    except Exception:
        return 1


def next_file_index(prefix, suffix):
    # 找到下一个可用的文件编号（从 1 开始递增）
    try:
        files = os.listdir("/sd")
        max_idx = 0
        for f in files:
            if f.startswith(prefix) and f.endswith(suffix):
                try:
                    idx = int(f[len(prefix):-len(suffix)])
                    if idx > max_idx:
                        max_idx = idx
                except ValueError:
                    pass
        return max_idx + 1
    except Exception:
        return 1


def update_recording_state():
    # 录制开始时根据标志位打开日志/视频文件, 停止时关闭
    global Record_State, mjpeg_flag, m_handle, log_file, record_state_flag, _record_frame_skip

    if Record_State == STATE_RECORD_START:
        if sd_mount_flag != 1:
            return
        if mjpeg_flag == 0:
            try:
                status = []
                if ENABLE_LOG_RECORDING:
                    idx = next_file_index("log_", ".txt")
                    log_file = open("/sd/log_{}.txt".format(idx), "w")
                    log_file.write("# tier, pixels, dist_cm, x, y, fps, pattern, t, V, d_phi, d_theta, d_psi, p, q, r, delta1, delta2, delta3, delta4\n")
                    status.append("log_{}.txt".format(idx))
                if ENABLE_VIDEO_RECORDING:
                    idx = next_file_index("record_", ".mjpeg")
                    m_handle = mjpeg.Mjpeg("/sd/record_{}.mjpeg".format(idx))
                    status.append("record_{}.mjpeg".format(idx))
                    _record_frame_skip = 0
                print("start record ({})".format(" + ".join(status) if status else "none"))
                mjpeg_flag = 1
            except Exception as e:
                Record_State = STATE_STOP
                print("record open failed: {}".format(e))

    elif Record_State == STATE_RECORD_STOP:
        if mjpeg_flag == 1:
            try:
                if m_handle is not None:
                    m_handle.close()
                if log_file is not None:
                    log_file.close()
                mjpeg_flag = 0
                if record_state_flag < 2:
                    send_record_state(1, 5)
                    record_state_flag = 2
                print("record stopped")
            except Exception as e:
                print("record close failed: {}".format(e))
            finally:
                mjpeg_flag = 0
                m_handle = None
                log_file = None
        Record_State = STATE_IDLE


# ======================== UART 通信 ========================
Rx_Head_Debug = 0x57
Rx_Tail_Debug = 0x75
Rx_Length_Debug = 50                     # 1 头 + 12×4B float + 1 尾 = 50
# uart_rx_buf_Debug 已废弃: 两种帧共用 uart_rx_buf, 由 Uart_Rx_Data 统一收发

data = array('f', [0.0] * 12)            # 调试帧解出的 12 个 float

def Uart_Rx_Data():
    # 单 UART 同时收两种帧, 必须由一个函数统一 read 再按帧头分流:
    #   命令帧 0x5A + cmd + 0xA5            (3B)  -> 改状态机
    #   调试帧 0x57 + 12×float(大端) + 0x75  (50B) -> 填 data[0..11]
    # 为何不能拆成两个函数各自调: uart.read() 一次清空 FIFO, 谁先读谁拿走全部字节, 另一个永远收不到.
    # 容忍脏字节: 帧头不认识跳 1B; 帧尾不对(帧头是巧合)也跳 1B; 残帧留到下次拼齐.
    global current_state, uart_rx_buf, Record_State

    if uart.any():
        rx_data = uart.read(uart.any())
        if rx_data is not None:
            uart_rx_buf += rx_data
            uart_rx_buf = uart_rx_buf[-1024:]

    i = 0
    n = len(uart_rx_buf)
    while i < n:
        b = uart_rx_buf[i]

        if b == Rx_Head:                                  # ---- 命令帧 (3B) ----
            if i + Rx_Length > n:                         # 残帧, 留到下次拼齐
                break
            if uart_rx_buf[i + Rx_Length - 1] != Rx_Tail:
                i += 1                                    # 帧尾不对, 0x5A 是巧合, 跳 1B
                continue
            cmd = uart_rx_buf[i + 1]
            if cmd == 0x00:
                current_state = STATE_WORK
            elif cmd == 0x01:
                current_state = STATE_STOP
            elif cmd == 0x02:
                current_state = STATE_Self_Text
            elif cmd == 0x03:
                Record_State = STATE_RECORD_START
            elif cmd == 0x04:
                Record_State = STATE_RECORD_STOP
            i += Rx_Length
            continue

        if b == Rx_Head_Debug:                            # ---- 调试帧 (50B) ----
            if i + Rx_Length_Debug > n:                   # 残帧, 留到下次拼齐
                break
            if uart_rx_buf[i + Rx_Length_Debug - 1] != Rx_Tail_Debug:
                i += 1                                    # 帧尾不对, 0x57 是巧合, 跳 1B
                continue
            vals = struct.unpack('>12f', uart_rx_buf[i + 1:i + 49])   # 大端 12 个 float
            for k in range(12):
                data[k] = vals[k]
            # print("Debug", vals)                          # 确认收到; 不需要可删/降频
            i += Rx_Length_Debug
            continue

        i += 1                                            # 垃圾字节, 跳过

    uart_rx_buf = uart_rx_buf[i:]                         # 丢弃已处理部分, 残帧留到下次


def _send_xy(head, tail, x, y):
    # 共用 6B (x,y) 包. & 0xFF 显式截位, 防 x/y 是负数时 bytearray 报错.
    uart.write(bytearray([
        head,
        (x >> 8) & 0xFF, x & 0xFF,
        (y >> 8) & 0xFF, y & 0xFF,
        tail,
    ]))


def send_data(x, y):                          # [识别到] 0x5A + xy + 0xA5
    _send_xy(0x5A, 0xA5, x, y)
    print(x,y)


def send_none(x, y):                          # [未识别] 0x7A + xy + 0xA7, 一般 x=y=0
    _send_xy(0x7A, 0xA7, x, y)


def send_Self_Text_data():
    # 自检回包 0x5A 0x02 0xA5 01 02 03. 飞控 0x02 触发, 确认 UART 通路.
    uart.write(bytearray([0x5A, 0x02, 0xA5, 1, 2, 3]))
    print("self test sent")


def send_distance(dist_cm, area):
    # 距离+面积扩展包 (6B): 0x5B + dist_hi + dist_lo + area_hi + area_lo + 0xA6.
    # 均 uint16 大端: dist_cm = DIST_K/sqrt(px) (cm), area = 当前目标 blob 像素数.
    dist_cm = max(0, min(65535, int(dist_cm)))
    area = max(0, min(65535, int(area)))
    uart.write(bytearray([
        0x5B,
        (dist_cm >> 8) & 0xFF, dist_cm & 0xFF,
        (area >> 8) & 0xFF, area & 0xFF,
        0xA6,
    ]))


def send_record_state(x, y):
    # 录像状态通知包 (6B): 0x9A + xy + 0xA9, 与 main.py 协议一致.
    # (1,0)=录像已开始; (1,5)=录像已结束. x/y 占位语义, 非像素.
    uart.write(bytearray([
        0x9A,
        (x >> 8) & 0xFF, x & 0xFF,
        (y >> 8) & 0xFF, y & 0xFF,
        0xA9,
    ]))


# ======================== 视觉: 距离档辅助 ========================
def pick_tier(pixels):
    # 按 pixels 选档. pixels=0 (无目标) 返回 DEFAULT_TIER_IDX 防跳到 FAR.
    for i, tier in enumerate(DIST_TIERS):
        if tier["pixels_min"] <= pixels < tier["pixels_max"]:
            return i
    return DEFAULT_TIER_IDX


def apply_tier(tier_idx):
    # 切档只更新索引 + 累积本帧 tier_switch_msg. 曝光全程锁定, 不动 set_auto_exposure.
    global current_tier_idx, tier_switch_msg
    if tier_idx != current_tier_idx:
        current_tier_idx = tier_idx
        tier_switch_msg = " switch->%s" % DIST_TIERS[tier_idx]["name"]


def estimate_distance_cm(pixels):
    # 反平方根估算 (cm). pixels<=1 返回 9999 (无穷远 sentinel). 粗估, 不要做闭环.
    if pixels <= 1:
        return 9999
    return DIST_K / math.sqrt(pixels)


# ======================== 视觉: 像素颜色判定 ========================
# 单像素级判定, 是 classify_pattern / is_noise_color 的基础. 所有 fn 接受 None 像素返回 False.

def get_pixel_safe(img, px, py):
    # 取 RGB 像素元组. 越界返回 None.
    if 0 <= px < img.width() and 0 <= py < img.height():
        return img.get_pixel(px, py)
    return None


def is_green_pixel(pixel):
    # 青绿容忍版 (per led-physics 记忆): 实测 LED 中心 RGB ≈ (100,255,245), B 几乎和 G 同高.
    # 4 条: G>=阈值 / G-R 主导 / G>=B (排青蓝) / 非饱和时色度跨度>=阈值 (排灰白).
    if pixel is None:
        return False
    r, g, b = pixel
    if g < MIN_GREEN_VALUE:
        return False
    if (g - r) < MIN_GREEN_DOMINANCE:
        return False
    if g < b:                                 # B>G → 青/蓝, 非绿
        return False
    if max(r, g, b) < 200 and (max(r, g, b) - min(r, g, b)) < MIN_COLOR_SPREAD:
        return False                          # 非饱和但 RGB 接近 → 灰白
    return True


def is_white_pixel(pixel):
    # max(R,G,B)>=WHITE_BRIGHTNESS_MIN 且三通道极差<=MAX_WHITE_DELTA → 白/灰白. is_noise_color 用.
    if pixel is None:
        return False
    r, g, b = pixel
    max_rgb = max(r, g, b)
    min_rgb = min(r, g, b)
    return max_rgb >= WHITE_BRIGHTNESS_MIN and (max_rgb - min_rgb) <= MAX_WHITE_DELTA


def is_saturated_bright(pixel):
    # halo 核判定: min(RGB)>=160 (三通道高亮) + (颜色接近中性 OR 本身就是绿色).
    # 原始只认中性白核, 但绿灯过曝中心是绿白色 (G>>R,B), 也应当能触发 HALO.
    if pixel is None:
        return False
    r, g, b = pixel
    min_rgb = min(r, g, b)
    max_rgb = max(r, g, b)
    if min_rgb < CENTER_SATURATED_MIN_RGB:
        return False
    # 中性白核 (R≈G≈B)
    if (max_rgb - min_rgb) <= MAX_WHITE_DELTA + 14:
        return True
    # 绿白色核 (绿灯过曝: G 很高, R/B 相对低但仍 >= 阈值)
    if is_green_pixel(pixel):
        return True
    return False


def is_noise_color(pixel):
    # 非绿高亮干扰判定. 覆盖 4 类典型 FP: 白/灰白高亮、偏红、偏蓝、暖色黄 (R/G 亮 B 弱).
    # 真绿优先排除 — 用途: classify_pattern 数外环 4 点采样里几个是噪声色.
    if pixel is None:
        return False
    if is_green_pixel(pixel):
        return False
    r, g, b = pixel
    if is_white_pixel(pixel):
        return True
    if r > g + NOISE_COLOR_DELTA and r > b + NOISE_COLOR_DELTA:    # 偏红
        return True
    if b > g + NOISE_COLOR_DELTA and b > r + NOISE_COLOR_DELTA:    # 偏蓝
        return True
    if r > WHITE_BRIGHTNESS_MIN and g > WHITE_BRIGHTNESS_MIN and b < min(r, g) - NOISE_MIXED_DELTA:
        return True                                                # 暖色黄 (排除 R+G+B 都高的纯白)
    return False


# ======================== 视觉: blob 采样与分类 ========================
def sample_offsets_rotated(blob):
    # 沿 blob 主轴/次轴生成中心 5 点 + 外环 4 点采样偏移 (相对中心).
    # 为什么旋转感知: LED 倾斜成椭圆 (per led-physics 记忆), bbox 水平/垂直采样会落椭圆外.
    # 半径用 min(w,h)/2 (内接圆) 而非 max, 旋转后采样点仍在椭圆内.
    theta = blob.rotation()
    cos_t = math.cos(theta)
    sin_t = math.sin(theta)
    radius = max(2, min(blob.w(), blob.h()) // 2)
    inner = max(1, radius // 2)

    def rot(dx, dy):
        return (int(round(dx * cos_t - dy * sin_t)),
                int(round(dx * sin_t + dy * cos_t)))

    center = (                                # 5 点: 正中 + 主轴±inner + 次轴±inner
        (0, 0),
        rot(-inner, 0), rot(inner, 0),
        rot(0, -inner), rot(0, inner),
    )
    ring = (                                  # 4 点: 主/次轴两端, 探测环上被噪声污染
        rot(-radius, 0), rot(radius, 0),
        rot(0, -radius), rot(0, radius),
    )
    return center, ring


def classify_pattern(tier, center_samples, ring_samples):
    # 显式判定 SOLID (中心绿, 远/中距标准) / HALO (白核+绿环, 近距过曝标准) / None (拒).
    # 关键: 近距 LED 中心必然洗白, 单阈值挡不住 — 必须靠两种形态二选一.
    # 返回 {pattern, center_green, ring_green, ring_noise} 或 None.
    cg = sum(1 for p in center_samples if is_green_pixel(p))
    cs = sum(1 for p in center_samples if is_saturated_bright(p))
    rg = sum(1 for p in ring_samples if is_green_pixel(p))
    rn = sum(1 for p in ring_samples if is_noise_color(p))

    if rn > tier["max_ring_noise"]:           # 环境太脏直接拒
        return None

    is_solid = cg >= tier["min_center_green"]
    is_halo = (cs >= tier["min_center_saturated"]
               and rg >= tier["min_ring_green"])
    if not (is_solid or is_halo):
        return None

    return {                                  # SOLID 优先 (可信度比 HALO 高)
        "pattern": "SOLID" if is_solid else "HALO",
        "center_green": cg,
        "ring_green": rg,
        "ring_noise": rn,
    }


def measure_green_blob(img, blob, tier, is_tracked=False):
    # 几何 + 结构化校验, 通过返回 {blob, score, radius, center_green, [pattern]}, 失败返回 None.
    # 校验顺序按代价从低到高: roundness → density → brightness → a_mean → classify_pattern (最贵).
    # is_tracked=True 快路径跳过第 5 步采样 (信任上一帧已验证), 省 1-2ms/帧, 失锁后会重做完整校验.
    bw = blob.w()
    bh = blob.h()
    if bw <= 0 or bh <= 0:
        return None

    radius = max(1, min(bw, bh) // 2)
    roundness_ratio = min(bw, bh) / max(bw, bh)

    # 1) 圆度
    if roundness_ratio < tier["roundness_min"]:
        draw_reject_marker(img, blob, "R")
        return None

    # 2) 密度: pixels/bbox_area. <min=散点/L 形, >max=完整矩形
    density = blob.density()
    if density < tier["density_min"] or density > tier["density_max"]:
        draw_reject_marker(img, blob, "D")
        return None

    # 3) 亮度: blob 区域 L 通道均值
    stats = img.get_statistics(roi=blob.rect())
    l_mean = stats.l_mean()
    if l_mean < tier["min_brightness"] or l_mean > tier["max_brightness"]:
        draw_reject_marker(img, blob, "L")
        return None

    # 4) LAB 色度 a_mean (越负越偏绿)
    a_limit = BLOB_A_LIMIT_FAR if tier["name"] == "FAR" else BLOB_A_LIMIT_DEFAULT
    if stats.a_mean() > a_limit:
        draw_reject_marker(img, blob, "A")
        return None

    # 快速路径 1: 跟踪命中 — pattern 缺失, 主循环用 track_pattern
    if is_tracked:
        return {
            "blob": blob,
            "score": blob.pixels() + int(roundness_ratio * 100) + 100,
            "radius": radius,
            "center_green": tier["min_center_green"],
        }

    # 快速路径 2: 远档微小 blob (radius 太小, 采样退化) — 信任 find_blobs LAB 阈值
    if tier["name"] == "FAR" and blob.pixels() < FAR_TINY_BLOB_PX:
        return {
            "blob": blob,
            "score": blob.pixels() * 5 + int(roundness_ratio * 100),
            "radius": radius,
            "center_green": tier["min_center_green"],
        }

    # 5) 结构化采样 + SOLID/HALO 分类
    center_offs, ring_offs = sample_offsets_rotated(blob)
    cx, cy = blob.cx(), blob.cy()
    center_samples = [get_pixel_safe(img, cx + dx, cy + dy) for dx, dy in center_offs]
    ring_samples = [get_pixel_safe(img, cx + dx, cy + dy) for dx, dy in ring_offs]

    cls = classify_pattern(tier, center_samples, ring_samples)
    if cls is None:
        # Fallback SOLID: cg>=1 + blob is green enough (a_mean <= -10) → accept anyway
        cg = sum(1 for p in center_samples if is_green_pixel(p))
        if cg >= 1 and stats.a_mean() <= -10:
            cls = {"pattern": "SOLID", "center_green": cg, "ring_green": 0, "ring_noise": 0}
        else:
            draw_reject_marker(img, blob, "S")
            return None

    # 综合打分: sqrt(area)*20 + 圆度*100 + 中心绿*40 + 环绿*15 - 环噪*25 [+ HALO bonus]
    import math
    score = (int(math.sqrt(blob.pixels()) * 20)
             + int(roundness_ratio * 100)
             + cls["center_green"] * 40
             + cls["ring_green"] * 15
             - cls["ring_noise"] * 25)
    if cls["pattern"] == "HALO":
        score += HALO_PATTERN_SCORE_BONUS

    return {
        "blob": blob,
        "score": score,
        "radius": radius,
        "center_green": cls["center_green"],
        "pattern": cls["pattern"],
    }


# ======================== 视觉: 检测流水线 ========================
def tracking_bonus(blob, radius):
    # 靠近上次目标加分远离扣分, 防多绿灯场景跳目标. 阈值用半径而非固定值适应大小目标.
    if track_cx < 0 or track_cy < 0:
        return 0
    dx = blob.cx() - track_cx
    dy = blob.cy() - track_cy
    distance_sq = dx * dx + dy * dy
    allowed = max(radius, track_radius) + TRACK_DISTANCE_MARGIN
    if distance_sq > allowed * allowed:
        return -80                            # 重罚: 基本被其他候选挤掉
    return 30                                 # 范围内: 中等加分


def predict_roi(img):
    # 根据上一帧位置 + 速度外推 + 丢失帧数预测搜索 ROI. 返回 (x0,y0,w,h) 或 None.
    # 半径 = max(基础, radius*4) + |v|*VEL_GAIN + 丢失帧*LOST_GAIN.
    if track_cx < 0 or track_lost_count >= ROI_FULL_SEARCH_LOST:
        return None

    base = max(ROI_BASE_RADIUS, track_radius * 4)
    extra = (abs(track_vx) + abs(track_vy)) * ROI_VELOCITY_GAIN
    extra += track_lost_count * ROI_LOST_GAIN
    r = int(base + extra)

    cx = track_cx + track_vx                  # 一阶外推 (假定速度恒定)
    cy = track_cy + track_vy
    x0 = max(0, cx - r)
    y0 = max(0, cy - r)
    x1 = min(img.width(), cx + r)
    y1 = min(img.height(), cy + r)
    w = x1 - x0
    h = y1 - y0
    if w < 20 or h < 20:                      # ROI 太小不如全图
        return None
    return (x0, y0, w, h)


def _find_blobs(img, tier, roi=None):
    # find_blobs 统一调用. 抽出来是为了 ROI 命中/落空双路径不复制参数.
    kwargs = {
        "pixels_threshold": tier["pixels_threshold"],
        "area_threshold": tier["pixels_threshold"],
        "merge": True,                        # 重叠 blob 合并防被切成碎块
    }
    if roi is not None:
        kwargs["roi"] = roi
    return img.find_blobs([tier["threshold"]], **kwargs)


def detect_green_target(img):
    # 完整检测流水线 (每帧一次):
    #   1) predict_roi 算搜索窗 (无历史就全图)
    #   2) _find_blobs 找候选, ROI 落空回退全图
    #   3) measure_green_blob 校验+打分 + tracking_bonus 防跳目标
    #   4) 返回最高分 (无候选 None)
    global last_candidate_count
    tier = DIST_TIERS[current_tier_idx]

    roi = predict_roi(img)
    blobs = _find_blobs(img, tier, roi)
    if roi is not None:
        if not blobs:
            blobs = _find_blobs(img, tier, None)     # ROI 落空 → 全图重搜
        else:
            img.draw_rectangle(roi, color=(0, 128, 0), thickness=1)    # 调试: ROI 命中框

    last_candidate_count = len(blobs)

    best_result = None
    best_score = -99999
    # is_tracked 判断只在上帧命中时启用, 防失锁多帧后还用老位置
    track_active = track_cx >= 0 and track_lost_count == 0
    track_allowed_sq = 0
    if track_active:
        track_allowed = track_radius + TRACK_DISTANCE_MARGIN
        track_allowed_sq = track_allowed * track_allowed
    for blob in blobs:
        is_tracked = False
        if track_active:
            dx = blob.cx() - track_cx
            dy = blob.cy() - track_cy
            is_tracked = (dx * dx + dy * dy) <= track_allowed_sq
        result = measure_green_blob(img, blob, tier, is_tracked=is_tracked)
        if result is None:
            continue
        score = result["score"] + tracking_bonus(blob, result["radius"])
        if score > best_score:
            best_score = score
            best_result = result

    if best_result is None:
        return None
    best_result["score"] = best_score
    return best_result


def update_tracking(result):
    # 时序滤波. 返回 None 表示"还不算锁定 / 已丢失", 返回 blob 表示主循环可上报坐标.
    # 丢失分级: <4 帧保留全状态; 4-9 帧保留 last_xy + vxvy 让 ROI 继续外推; >=10 帧彻底清零回到全图搜.
    # 命中分级: confirm 累计到 TRACK_CONFIRM_FRAMES (2) 才算"真锁定", 防 LED 闪烁瞬时单帧误命中.
    global track_cx, track_cy, track_radius, track_pixels
    global track_vx, track_vy, track_confirm_count, track_lost_count, track_pattern

    if result is None:
        track_lost_count += 1
        if track_lost_count >= 5:
            apply_tier(DEFAULT_TIER_IDX)       # 丢 5 帧就回 DEFAULT (FAR), 不要停留在意外切到的档
        if track_lost_count >= TRACK_LOST_TOLERANCE:
            if track_lost_count >= ROI_FULL_SEARCH_LOST:
                track_cx = -1
                track_cy = -1
                track_radius = 0
                track_pixels = 0
                track_vx = 0
                track_vy = 0
                track_confirm_count = 0
                track_pattern = "?"
        return None

    blob = result["blob"]
    new_cx = blob.cx()
    new_cy = blob.cy()

    if track_cx >= 0:                         # 一阶速度估计 (首帧 vx=vy=0)
        track_vx = new_cx - track_cx
        track_vy = new_cy - track_cy

    track_cx = new_cx
    track_cy = new_cy
    track_radius = result["radius"]
    track_pixels = blob.pixels()
    track_pattern = result.get("pattern", "?")    # 远档微小 blob 没 pattern
    track_lost_count = 0
    if track_confirm_count < TRACK_CONFIRM_FRAMES:
        track_confirm_count += 1

    if track_confirm_count < TRACK_CONFIRM_FRAMES:
        return None
    return blob


# ======================== 调试绘制 ========================
# 全部无条件画. 不要时在调用点把对应 draw_*/render_debug_overlay 注释掉即可.
def _classify_sample_color(pixel):
    # 采样点分类色: 绿=is_green, 白=halo 核, 品红=干扰, 中灰=未分类, 暗灰=越界
    if pixel is None:
        return (60, 60, 60)
    if is_green_pixel(pixel):
        return (0, 255, 0)
    if is_saturated_bright(pixel):
        return (255, 255, 255)
    if is_noise_color(pixel):
        return (255, 0, 255)
    return (120, 120, 120)


def draw_blob_samples(img, blob):
    # 画中心 5 点 + 外环 4 点采样, 颜色显示分类
    center_offs, ring_offs = sample_offsets_rotated(blob)
    cx, cy = blob.cx(), blob.cy()
    for dx, dy in center_offs + ring_offs:
        px, py = cx + dx, cy + dy
        img.draw_circle(px, py, 2,
                        color=_classify_sample_color(get_pixel_safe(img, px, py)),
                        thickness=1, fill=True)


def draw_reject_marker(img, blob, reason_code):
    # 被拒 blob 灰圆 + 字母 (R=圆度/D=密度/L=亮度/A=色度a/S=采样).
    # 比赛要彻底关 → measure_green_blob 里 5 处 draw_reject_marker 都注释.
    r = max(3, max(blob.w(), blob.h()) // 2 + 1)
    img.draw_circle(blob.cx(), blob.cy(), r, color=(90, 90, 90), thickness=1)
    img.draw_string(blob.cx() - 4, max(0, blob.cy() - r - 9), reason_code,
                    color=(200, 200, 200), scale=1)


def draw_pattern_label(img, blob, pattern):
    # blob 下方写命中模式 (SOLID 青 / HALO 黄)
    color = (0, 255, 255) if pattern == "SOLID" else (255, 255, 0)
    img.draw_string(blob.x(), blob.y() + blob.h() + 2, pattern, color=color, scale=1)


def draw_velocity_arrow(img):
    # 跟踪中心画速度矢量 (放大 3 倍). 没目标/v=0 跳过
    if track_cx < 0 or (track_vx == 0 and track_vy == 0):
        return
    end_x = int(track_cx + track_vx * 3)
    end_y = int(track_cy + track_vy * 3)
    img.draw_arrow(track_cx, track_cy, end_x, end_y, color=(255, 128, 0), thickness=2)


def draw_locked_target(img, blob):
    # 锁定: inner 红圆 + outer 青圆 + 采样/pattern/速度图层
    r_in = max(2, min(blob.w(), blob.h()) // 2)
    r_out = max(r_in + 3, max(blob.w(), blob.h()) // 2 + 2)
    img.draw_circle(blob.cx(), blob.cy(), r_out, color=(0, 255, 255), thickness=2)
    img.draw_circle(blob.cx(), blob.cy(), r_in, color=(255, 0, 0), thickness=2)
    draw_blob_samples(img, blob)
    draw_pattern_label(img, blob, track_pattern)
    draw_velocity_arrow(img)


def draw_hud(img, has_target, fps, x_out=0, y_out=0):
    # 左上角 HUD: 档位 / 候选数 / pattern / 像素 / 距离 / fps / xout / yout.
    tier_name = DIST_TIERS[current_tier_idx]["name"]
    line1 = "tier=%s cand=%d fps=%.1f" % (tier_name, last_candidate_count, fps)
    if has_target:
        line2 = "%s px=%d dist=%.0fcm" % (
            track_pattern, track_pixels, estimate_distance_cm(track_pixels))
        line3 = "xout=%d yout=%d" % (x_out, y_out)
    else:
        line2 = "NO TARGET"
        line3 = "xout=-- yout=--"
    img.draw_string(2, 2, line1, color=(255, 255, 0), scale=1, mono_space=False)
    img.draw_string(2, 12, line2, color=(255, 255, 0), scale=1, mono_space=False)
    img.draw_string(2, 22, line3, color=(0, 255, 255), scale=1, mono_space=False)


def draw_imu_debug(img):
    # 串口调试帧 data[0..11] 的 12 个量, 3 个一组画在 HUD 下方:
    #   ACC 加速度XYZ / GYR 陀螺PRY / CUR 当前欧拉角PRY / TGT 目标欧拉角PRY.
    groups = (("ACC", 0), ("GYR", 3), ("CUR", 6), ("TGT", 9))
