# ======================== 主循环 ========================
# 曝光已在 sensor.reset() → skip_frames 之间锁定, 这里不再重复设置.

try:
  while True:
    # ----- 帧率 & 通信 & SD (前置) -----
    update_fps()
    Uart_Rx_Data()                            # 可能改 current_state / Record_State
    mount_sd_if_needed()                      # SD 延迟挂载 (开机/失败重试)

    # IDE 测试: SD 挂载后自动触发录像. _auto_record_triggered 一次性闩防失败循环.
    if (DEBUG_AUTO_RECORD and not _auto_record_triggered
            and sd_mount_flag == 1 and Record_State == STATE_STOP):
        Record_State = STATE_RECORD_START
        _auto_record_triggered = True
        print("DEBUG: auto-record triggered (no FC)")

    # ----- 抓帧 -----
    img = sensor.snapshot()
    update_recording_state()

    # ----- 自适应切档 -----
    # 只在 track_pixels>0 时切. 启动/丢目标时停在 DEFAULT_TIER_IDX (=FAR),
    # 远距 4-14 px LED 只有 FAR 档能识别, MID/NEAR 的 min_brightness 会拒掉.
    if track_pixels > 0:
        apply_tier(pick_tier(track_pixels))

    # ----- 检测 + 时序跟踪 -----
    detection = detect_green_target(img)
    locked_blob = update_tracking(detection)
    has_target = locked_blob is not None

    # ----- 命中: 算坐标 -----
    x_out, y_out = 0, 0
    if has_target:
        x_out, y_out = compute_target_xy(locked_blob)

    # ----- 调试可视化 (比赛关掉省 16-19ms/帧, +5~12fps) -----
    render_debug_overlay(img, has_target, locked_blob, x_out, y_out)

    # ----- 录像 -----
    record_frame_to_sd(img)

    # ----- 记录识别数据到文本日志 -----
    log_detection_data(has_target, x_out, y_out)

    # ----- 根据工作状态机决定是否发包 -----
    if current_state == STATE_WORK:
        if has_target:
            send_data(int(x_out), int(y_out))         # 识别到目标 → 发坐标包
            if SEND_DISTANCE_PACKET:
                send_distance(estimate_distance_cm(track_pixels), track_pixels)
        else:
            send_none(0, 0)                           # 没识别 → 心跳"无目标"包
    elif current_state == STATE_Self_Text:
        current_state = STATE_IDLE                    # 自检一次性, 回包后立即回 IDLE
        send_Self_Text_data()


except KeyboardInterrupt:
    print("interrupted by user")
except Exception as e:
    print("main loop crashed: {}".format(e))
finally:
    # 关闭视频文件
    if m_handle is not None:
        try:
            m_handle.close()
            print("mjpeg closed")
        except Exception as e:
            print("mjpeg close failed: {}".format(e))
    # 关闭日志文件
    if log_file is not None:
        try:
            log_file.close()
            print("log closed")
        except Exception as e:
            print("log close failed: {}".format(e))
    try:
        os.sync()
        print("sd synced")
    except Exception as e:
        print("sync failed: {}".format(e))
